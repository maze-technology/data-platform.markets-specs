{
  "version": "1.0",
  "sources": [
    "src/main/smithy"
  ],
  "maven": {
    "dependencies": [
      "com.disneystreaming.alloy:alloy-core:0.3.40",
      "tech.maze:commons:0.0.19",
      "tech.maze:smithy-event-codegen:0.0.2",
      "tech.maze:smithy-event-traits:0.0.5"
    ],
    "repositories": [
      {
        "url": "https://scm.maze.trading/api/v4/groups/6/-/packages/maven",
        "httpCredentials": "${GITLAB_MAVEN_USER}:${GITLAB_MAVEN_PASSWORD}"
      },
      {
        "url": "https://scm.maze.trading/api/v4/groups/67/-/packages/maven",
        "httpCredentials": "${SMITHY_MAVEN_USER}:${SMITHY_MAVEN_PASSWORD}"
      },
      {
        "url": "https://repo.maven.apache.org/maven2/"
      }
    ]
  },
  "projections": {
    "resolved": {
      "plugins": {
        "maze-event-types": {
          "package": "tech.maze.dtos.markets.events",
          "className": "EventTypes"
        },
        "sources": {
          "format": "smithy",
          "outputDirectory": "model"
        }
      }
    }
  }
}
